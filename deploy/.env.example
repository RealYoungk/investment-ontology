# deploy/.env 로 복사해서 채운다. 이 파일에만 비밀값을 두고 저장소에 올리지 않는다.
DOMAIN=ontology.example.com

# 아무 긴 임의 문자열 (openssl rand -base64 32)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SERVICE_SECRET=

# 맥에서 쓰던 것과 같은 키
DART_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# AI 관계 추출을 쓸 때만
ANTHROPIC_API_KEY=

# 접속 비밀번호: docker run --rm caddy:2 caddy hash-password --plaintext '비밀번호'
BASIC_AUTH_USER=me
BASIC_AUTH_HASH=
