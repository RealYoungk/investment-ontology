# deploy/.env 로 복사해서 채운다. 이 파일에만 비밀값을 두고 저장소에 올리지 않는다.
DOMAIN=ontology.example.com

# 아무 긴 임의 문자열 (openssl rand -base64 32)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SERVICE_SECRET=

# 로그인 키. 배포마다 재생성하지 않는다 (배포마다 새로 만들지 말 것 — 바꾸면
# 발급된 로그인·리프레시 토큰이 전부 무효화된다). 각각 openssl rand -base64 48.
# jwtRefreshTokenHashPepper·emailSecretHashPepper는 10자 이상이어야 한다.
JWT_HMAC_SHA512_PRIVATE_KEY=
JWT_REFRESH_TOKEN_HASH_PEPPER=
EMAIL_SECRET_HASH_PEPPER=

# 맥에서 쓰던 것과 같은 키
DART_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# AI 관계 추출을 쓸 때만
ANTHROPIC_API_KEY=

# 이메일 인증을 마친 지정 계정에만 관리자 권한을 부여한다. 실제 운영자 이메일 입력.
ONTOLOGY_ADMIN_EMAILS=admin@example.com
