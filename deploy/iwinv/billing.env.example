# Server only; never commit runtime/billing.env or include it in the web build.
ALFINDER_BILLING_PROVIDER=portone
ALFINDER_BILLING_SANDBOX_ENABLED=false
ALFINDER_BILLING_LIVE_ENABLED=false
ALFINDER_PG_BILLING_APPROVED=false
ALFINDER_BILLING_PRIVACY_READY=false
ALFINDER_BILLING_TERMS_VERSION=2026-10-02
ALFINDER_BILLING_CHARGES_PAUSED=true
ALFINDER_NEW_SUBSCRIPTION_PRICE_KRW=4900
# Current adapter/browser flow is reviewed for NHN KCP V2 CARD billing.
PORTONE_CONTRACT_PG=kcp_v2
PORTONE_LIVE_STORE_ID=
PORTONE_LIVE_CHANNEL_KEY=
PORTONE_LIVE_API_SECRET=
# Reuse the existing vault key if there are stored billing references.
# A different encryption key makes existing billing references unreadable.
BILLING_ENCRYPTION_KEY=
# Must match the operator's approved production channel, not a TEST channel.
PORTONE_LIVE_CHANNEL_VERIFIED=false
